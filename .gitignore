node_modules
dist
out
.DS_Store
*.log
npm-debug.log*
.eslintcache

# Build output
release
# build/icon.png is the app icon (committed); generated .ico files are not.
build/*.ico

# Bundled mpv binaries are large and fetched on demand (see scripts/fetch-mpv.mjs).
# Ignore the contents but keep the directory (via .gitkeep).
resources/mpv/*
!resources/mpv/.gitkeep

# Local env / secrets
.env
.env.local

# Custom setup window build output
installer/bin
installer/obj
installer/out

# Apple device check report
apple/check/ello-apple-check.txt

# wireproxy for the built-in VPN is downloaded at build time.
resources/wireproxy/*
!resources/wireproxy/.gitkeep
apple-app/Frameworks/
