<Window x:Class="ElloSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ello smartTV Setup" Width="760" Height="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="{StaticResource Text}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Border CornerRadius="16" Background="#0E1013" BorderBrush="#26FFFFFF" BorderThickness="1"
          MouseLeftButtonDown="OnDrag">
    <Grid>
      <Grid.Clip>
        <RectangleGeometry Rect="0,0,758,458" RadiusX="15" RadiusY="15" />
      </Grid.Clip>

      <!-- Soft colour glow in the four brand colours. -->
      <Canvas IsHitTestVisible="False">
        <Ellipse Width="380" Height="380" Canvas.Left="-120" Canvas.Top="-170" Fill="#4C8DFF" Opacity="0.30">
          <Ellipse.Effect><BlurEffect Radius="150" /></Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="300" Height="300" Canvas.Left="560" Canvas.Top="-150" Fill="#EA4335" Opacity="0.20">
          <Ellipse.Effect><BlurEffect Radius="150" /></Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="320" Height="320" Canvas.Left="560" Canvas.Top="300" Fill="#FBBC04" Opacity="0.14">
          <Ellipse.Effect><BlurEffect Radius="150" /></Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="320" Height="320" Canvas.Left="-140" Canvas.Top="320" Fill="#34A853" Opacity="0.16">
          <Ellipse.Effect><BlurEffect Radius="150" /></Ellipse.Effect>
        </Ellipse>
      </Canvas>

      <!-- Window buttons -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0">
        <Button Style="{StaticResource WindowButton}" Content="&#xE921;" ToolTip="Minimize" Click="OnMinimize" />
        <Button x:Name="CloseButton" Style="{StaticResource WindowButton}" Content="&#xE8BB;" ToolTip="Close" Click="OnClose" />
      </StackPanel>

      <!-- Brand block, shared by every page. -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,58,0,0">
        <Border Width="84" Height="84" CornerRadius="20" HorizontalAlignment="Center">
          <Border.Background>
            <ImageBrush ImageSource="pack://application:,,,/icon.png" />
          </Border.Background>
          <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" Color="Black" />
          </Border.Effect>
        </Border>
        <TextBlock HorizontalAlignment="Center" Margin="0,18,0,0" FontSize="32">
          <Run Text="ello" FontWeight="Bold" /><Run Text="." FontWeight="Bold" Foreground="{StaticResource Accent}" /><Run Text=" smartTV" Foreground="{StaticResource TextDim}" />
        </TextBlock>
      </StackPanel>

      <!-- Page: welcome -->
      <Grid x:Name="WelcomePage" VerticalAlignment="Bottom" Margin="0,0,0,34">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock HorizontalAlignment="Center" FontSize="15" Foreground="{StaticResource TextDim}"
                     Text="Live TV, movies and series on a screen that feels like a TV." />
          <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="Install"
                  HorizontalAlignment="Center" MinWidth="180" Margin="0,26,0,0" Click="OnInstall" IsDefault="True" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
            <TextBlock Text="Install to " FontSize="13" Foreground="{StaticResource TextFaint}" />
            <TextBlock x:Name="DirText" FontSize="13" Foreground="{StaticResource TextDim}" MaxWidth="380"
                       TextTrimming="CharacterEllipsis" />
            <Button Style="{StaticResource LinkButton}" Content="Change" Margin="10,0,0,0" Click="OnBrowse" />
          </StackPanel>
          <CheckBox x:Name="DesktopBox" Style="{StaticResource Switch}" Content="Desktop shortcut"
                    IsChecked="True" HorizontalAlignment="Center" Margin="0,14,0,0" />
        </StackPanel>
      </Grid>

      <!-- Page: installing -->
      <Grid x:Name="ProgressPage" VerticalAlignment="Bottom" Margin="0,0,0,70" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" Width="420">
          <TextBlock x:Name="StatusText" HorizontalAlignment="Center" FontSize="15" Foreground="{StaticResource TextDim}"
                     Text="Getting things ready…" />
          <Grid Margin="0,22,0,0" Height="6">
            <Border CornerRadius="3" Background="#26FFFFFF" />
            <Border x:Name="ProgressFill" CornerRadius="3" Background="{StaticResource Accent}"
                    HorizontalAlignment="Left" Width="0" />
          </Grid>
          <TextBlock x:Name="PercentText" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="13"
                     Foreground="{StaticResource TextFaint}" Text="0%" />
        </StackPanel>
      </Grid>

      <!-- Page: done -->
      <Grid x:Name="DonePage" VerticalAlignment="Bottom" Margin="0,0,0,48" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="You're all set" />
          <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="14" Foreground="{StaticResource TextDim}"
                     Text="ello smartTV is installed and keeps itself up to date." />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
            <Button x:Name="LaunchButton" Style="{StaticResource PrimaryButton}" Content="Open ello smartTV"
                    Click="OnLaunch" IsDefault="True" />
            <Button Style="{StaticResource GhostButton}" Content="Close" Margin="12,0,0,0" Click="OnClose" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Page: error -->
      <Grid x:Name="ErrorPage" VerticalAlignment="Bottom" Margin="0,0,0,48" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" Width="520">
          <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Something went wrong" />
          <TextBlock x:Name="ErrorText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                     Margin="0,8,0,0" FontSize="14" Foreground="{StaticResource TextDim}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Try again" Click="OnInstall" />
            <Button Style="{StaticResource GhostButton}" Content="Close" Margin="12,0,0,0" Click="OnClose" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <TextBlock x:Name="VersionText" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,14"
                 FontSize="11" Foreground="{StaticResource TextFaint}" />
    </Grid>
  </Border>
</Window>
